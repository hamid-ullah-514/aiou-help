# AIOU Help — Environment Configuration Example
# Rename this file to .env or set these in your Vercel Project Settings > Environment Variables

# Optional Gemini API Key for extended AI explanations (The website works 100% without this key using verified book databases)
GEMINI_API_KEY=your_gemini_api_key_here

# Local Server Settings (Used only for local testing)
AIOU_HOST=127.0.0.1
AIOU_PORT=8000
