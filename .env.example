# AIOU Help — Environment Configuration Example
# Rename this file to .env or set these in your Vercel Project Settings > Environment Variables

# Groq High-Speed AI API Key (Provides instant book-grounded answers & Vision question solver)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Optional Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Local Server Settings (Used only for local testing)
AIOU_HOST=127.0.0.1
AIOU_PORT=8000
