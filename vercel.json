{
  "version": 2,
  "functions": {
    "api/index.py": {
      "excludeFiles": "{*semster book/**,*.pdf,*.docx,*.doc,data/*.db*,data/aiou_search.db}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
